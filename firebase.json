{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/parent", "destination": "/parent.html" },
      { "source": "/parent/**", "destination": "/parent.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
