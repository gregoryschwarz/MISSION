rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsFamily(familyId) {
      return signedIn()
        && request.auth.uid ==
          get(/databases/$(database)/documents/families/$(familyId)).data.parentUid;
    }

    function ownsChild(childId) {
      return ownsFamily(
        get(/databases/$(database)/documents/children/$(childId)).data.familyId
      );
    }

    function isChildDevice(childId) {
      return signedIn()
        && request.auth.uid ==
          get(/databases/$(database)/documents/children/$(childId)).data.deviceUid;
    }

    match /families/{familyId} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.parentUid;

      allow read, update, delete: if signedIn()
        && request.auth.uid == resource.data.parentUid;

      match /rewards/{rewardId} {
        allow read: if signedIn();
        allow write: if ownsFamily(familyId);
      }
    }

    match /pairingCodes/{pairingCode} {
      // Le code public ne contient que l'identifiant technique de l'enfant
      // et celui de sa famille. Aucun profil enfant n'est exposé ici.
      allow get: if signedIn();
      allow list: if false;

      allow create: if ownsFamily(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly([
          'childId',
          'familyId'
        ]);

      allow update, delete: if ownsFamily(resource.data.familyId);
    }

    match /children/{childId} {
      allow create: if ownsFamily(request.resource.data.familyId)
        && request.resource.data.deviceUid == null
        && request.resource.data.pairingCode is string;

      allow read: if ownsFamily(resource.data.familyId)
        || (
          signedIn()
          && request.auth.uid == resource.data.deviceUid
        );

      allow delete: if ownsFamily(resource.data.familyId);

      allow update: if ownsFamily(resource.data.familyId)
        || (
          signedIn()
          && request.auth.uid == resource.data.deviceUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'xp',
            'avatarLevel',
            'badges',
            'badgeDates',
            'dailyChallengeDate',
            'dailyChallengeProgress',
            'dailyChallengeCompleted',
            'streakDays',
            'lastSessionDate',
            'difficultyLevels',
            'perfectMissionsCount',
            'totalCorrectCount',
            'coins',
            'selectedCharacter',
            'selectedHat',
            'selectedCape',
            'selectedDecor',
            'selectedHairstyle',
            'selectedOutfit',
            'selectedCompanion',
            'selectedCompanionAccessory',
            'ownedCharacterIds',
            'weeklyGoalProgress',
            'weeklyGoalWeekStart',
            'dailyMissionCount',
            'dailyMissionCountDate'
          ])
        );

      match /pairingRequests/{deviceUid} {

        // Première demande de la tablette.
        allow create: if signedIn()
          && request.auth.uid == deviceUid
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'requesterUid',
            'status',
            'requestedAt'
          ]);

        allow get: if signedIn()
          && (
            request.auth.uid == deviceUid
            || ownsChild(childId)
          );

        allow list: if ownsChild(childId);

        // Le parent accepte ou refuse la demande.
        allow update: if ownsChild(childId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'resolvedAt'
          ])
          && request.resource.data.status in [
            'approved',
            'rejected'
          ];

        // Une tablette déjà connue peut renvoyer une demande.
        // Utile après un refus, une révocation ou une nouvelle tentative.
        allow update: if signedIn()
          && request.auth.uid == deviceUid
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'requesterUid',
            'status',
            'requestedAt',
            'resolvedAt'
          ]);

        allow delete: if ownsChild(childId);
      }

      match /sessions/{sessionId} {
        allow create: if isChildDevice(childId);
        allow read: if ownsChild(childId);
      }

      match /rewardRequests/{requestId} {
        allow create, read: if isChildDevice(childId);
        allow read, update: if ownsChild(childId);
      }
    }
  }
}
